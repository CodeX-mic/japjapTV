# Uploaded logo files only. Never execute scripts from this directory.
Options -Indexes

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(?:php[0-9]?|phtml|phar|pl|py|rb|cgi|sh|bash|bat|cmd|ps1|exe|dll|so|htaccess)$">
    Require all denied
</FilesMatch>
